# 复制本文件为 .env.local，再填入自己的 Key
#
# 智谱 GLM（免费模型）：https://open.bigmodel.cn/
#   LLM_MODEL 可选：glm-4.7-flash / glm-4.5-flash / glm-4-flash
#   LLM_MODEL_FALLBACKS 用于主模型被限流时自动降级

LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
LLM_MODEL_FALLBACKS=glm-4.5-flash,glm-4-flash
